;; green (land)
to draw-landmass [x1 y1 x2 y2]
  ask patches [
    if pxcor >= x1 and pxcor <= x2 and pycor >= y1 and pycor <= y2 and pzcor = -16 [
      set pcolor 55     ;; green land
      let rgbVer extract-rgb pcolor
      set pcolor (list item 0 rgbVer item 1 rgbVer item 2 rgbVer 255)
      set is-land? true
    ]
  ]
end

;; airports: (Yellow patches with labels)

to place-airports
  ;; Define airport locations: [x y "name"]
  set airport-locations (list
    (list -24    4 -16 "YYC")    ;; Calgary, Canada
    (list -25    2 -16 "JFK")    ;; New York, USA
    (list -22    1 -16 "LAX")    ;; Los Angeles, USA
    (list -20   -3 -16 "MEX")    ;; Mexico City
    (list -13  -12 -16 "GRU")    ;; São Paulo, Brazil
    (list -16  -15 -16 "EZE")    ;; Buenos Aires, Argentina
    (list   2    4 -16 "LHR")    ;; London, UK
    (list   6    3 -16 "CDG")    ;; Paris, France
    (list   3   -1 -16 "CAI")    ;; Cairo, Egypt
    (list   3  -12 -16 "JNB")    ;; Johannesburg, South Africa
    (list   6    0 -16 "DXB")    ;; Dubai, UAE
    (list  11    5 -16 "SVO")    ;; Moscow, Russia
    (list  15   -5 -16 "BOM")    ;; Mumbai, India
    (list  20    5 -16 "PEK")    ;; Beijing, China
    (list  20    0 -16 "HKG")    ;; Hong Kong
    (list  29  -14 -16 "SYD")    ;; Sydney, Australia
 
  )

  ;; Paint each airport location yellow and label it
  foreach airport-locations [ loc ->
    let ax item 0 loc
    let ay item 1 loc
    let az item 2 loc
    let aname item 3 loc
    
    ;; Make a 1-patch airport marker (yellow)
    ask patch ax ay az [
      set pcolor 45          ;; yellow
      let rgbVer extract-rgb pcolor
      set pcolor (list item 0 rgbVer item 1 rgbVer item 2 rgbVer 255)
      set is-airport? true
      set is-land? true
      set airport-name aname
    ]
  ]
end
  
;; air traffic controllers (Red patches)
;; Controllers are placed on land between airports

to place-controllers
  
  let height 3
  
  ;; Define ATC positions on land, spread around the map
  set controller-locations (list
    (list -23  11)    ;; Northern Canada ATC
    (list -20   2)    ;; US East Coast ATC
    (list -19   -5)    ;; Central America ATC
    (list -15 -13)    ;; South America ATC
    (list   7   9)    ;; European ATC
    (list   -3  -4)    ;; Central Africa ATC
    (list  16   6)      ;; Russia West ATC
    (list  9  0)     ;; Middle East ATC
    (list  26  6)    ;; East Asia ATC
    (list  19   -6)    ;; South Asia ATC
    (list  24 -13)    ;; Australia ATC
    (list -6 13)     ;; Atlantic ATC
  )

  ;; Only place up to NumOfAirTrafficControllers controllers
  let num-to-place min (list NumOfAirTrafficControllers length controller-locations)
  set placed 0

  
  
  while [placed < num-to-place] [
    set controllerFound false
    let contr_location_length (length controller-locations)
    let randomIndex (random contr_location_length)
    let cx item 0 item randomIndex controller-locations
    let cy item 1 item randomIndex controller-locations
    ask patch cx cy -16 [
      if not is-airport? and not is-controller? [
        set pcolor blue
        let rgbVer extract-rgb pcolor
        set pcolor (list item 0 rgbVer item 1 rgbVer item 2 rgbVer 255)
       
        set is-controller? true

        set placed placed + 1
        set controllerFound true
        set controller-locations remove-item randomIndex controller-locations
        
      ]
      
      
    ]
    
    if controllerFound [
      let currentHeight 0
      while [currentHeight <= height] [
        ask patch cx cy (-16 + currentHeight) [
          set pcolor blue
          let rgbVer extract-rgb pcolor
          set pcolor (list item 0 rgbVer item 1 rgbVer item 2 rgbVer 255)
          set is-land? true
          
          if currentHeight = height [
            set plabel "ATC"
          ]
          set plabel-color white
        ]
        set currentHeight currentHeight + 1
      ]
    ]
    
  ]
end

;; Airplane spawning ----------------------

to spawn-airplanes
  ;; Maintain the target count of active airplanes
  let current-count count planes
  let needed max (list 0 (NumOfAirplanes - current-count))

  repeat needed [
    ;; Pick random distinct origin and destination airports
    let src one-of airport-locations
    let dst one-of airport-locations
    while [item 0 dst = item 0 src and item 1 dst = item 1 src] [
      set dst one-of airport-locations
    ]

    create-planes 1 [
      set shape "airplane"
      set color white
      set size 1.2
      set label ""

      set origin-x item 0 src
      set origin-y item 1 src
      set origin-z item 2 src
      set dest-x   item 0 dst
      set dest-y   item 1 dst
      set dest-z  item 2 src
      
      set dest patch item 0 dst item 1 dst item 2 dst

      ;; Stagger departure progress so planes don't all start at origin
      set flight-progress random-float 1.0
      ;; Speed variation: slower planes = 0.003, faster = 0.008
      set flight-speed    0.003 + random-float 0.005
      ;; Arc curvature: positive = curves one way, negative = other way
      set arc-factor (random-float 4 - 2)
      set crashed? false
      set in-collision-course? false
      set collision-self-detected false
      set takeoff-allowed? false
      
      ;; Assign a random cruise altitude between the slider min and max
      let alt-range (MaxFlightAltitude - MinFlightAltitude)
      set flight-altitude MinFlightAltitude + random-float (max (list alt-range 0))
      
      ;; Compute total horizontal distance for parabolic progress calculation
      let dx1 dest-x - origin-x
      let dy1 dest-y - origin-y
      set total-distance sqrt (dx1 * dx1 + dy1 * dy1)
      
      ;; Set location at the airport
      setxyz origin-x origin-y origin-z

      ;; Place at correct position along arc immediately
      update-position
    ]
  ]
end

;; Position update along arc----------------------

;; Is there any way to have the planes wrap around to get to the airports by shortest means? Eg: use the face method
; face method works as such: If wrapping is allowed by the topology and the wrapped distance (around the edges of the world) is shorter, face will use the wrapped path.
; If the caller and the agent are at the exact same position, the caller’s heading won’t change.

;; Called on the airplane turtle; sets its xcor/ycor along a curved arc.
to update-position
  let t flight-progress
  let delta-x dest-x - origin-x
  let delta-y dest-y - origin-y
  let d sqrt (delta-x * delta-x + delta-y * delta-y)
  
  if takeoff-allowed? [
    ;; Compute parabolic altitude: rises from ground at origin, peaks at midpoint, descends to ground at dest
    ifelse total-distance > 0 [
      let horiz-dist distancexy dest-x dest-y
      let horiz-progress 1 - (horiz-dist / total-distance)
      set horiz-progress max (list 0 (min (list 1 horiz-progress)))
      let target-z -16 + flight-altitude * sin (horiz-progress * 180)
      set zcor target-z
    ] [
      set zcor -15
    ]
    let numOfTurtles 0
    set ahead-patches n-values AircraftPerceptionRange [ i ->
      patch-ahead (i + 1)
    ]
    let index 0
    
    while [index <  length ahead-patches] [
      if count other planes-on item index ahead-patches > 0 [
        set collision-self-detected true
        set incoming-plane one-of other planes-on item index ahead-patches
        set index length ahead-patches
      ]
      
      set index index + 1
    ]
    
    if collision-self-detected = true and is-plane? incoming-plane [
      set color orange
      let incoming-heading 0
      let incoming-pitch 0
      ask incoming-plane [
        set incoming-heading heading
        set incoming-pitch pitch
      ]
      let incoming-heading-normalised incoming-heading - heading
      let incoming-pitch-normalised incoming-pitch - pitch
      if incoming-heading-normalised > 180 [ 
        set incoming-heading-normalised incoming-heading-normalised - 360 
      ]  ;; now -180 to 180
      if incoming-pitch-normalised > 180 [ 
        set incoming-pitch-normalised incoming-pitch-normalised - 360 
      ]  ;; now -180 to 180
      ifelse incoming-heading-normalised > 0 [ 
        left 10
      ] 
      [ 
        right 10
      ]
      
      ifelse incoming-pitch-normalised > 0 [ 
        set pitch pitch - 10
      ] 
      [ 
        set pitch pitch + 10
      ]
    ]
    
    ;; Collision detection based on what the air traffic controller tells them
    if in-collision-course? [
      set ahead-patches n-values AirTrafficControllerRange [ i ->
        patch-ahead (i + 1)
      ]
      let collision-spot-detected false
      set index 0
      while [index <  length ahead-patches] [
        ask item index ahead-patches [
          let current-rgb ifelse-value (is-list? pcolor) 
                        [ pcolor ] 
          [ extract-rgb pcolor ]
          if item 0 current-rgb > 150 [
            set collision-spot-detected true
          ]
        ]
        set index index + 1
      ]
      if collision-spot-detected = true [
        set color orange
        let rand random 3
        (ifelse
          rand = 0 [ 
            set pitch pitch + 20
            ;;print("Up")
          ]
          rand = 1 [ 
            set pitch pitch - 20
            ;;print("down")
          ]
          ; default
          []
        )
        
        set rand random 2
        
        (ifelse
          rand = 0 [ 
            ;;print("right")
            right 20
          ]
          rand = 1 [ 
            ;;print("left")
            left 20 
          ]
        )
        
      ]
    ]
    
    ;; Compute a look-ahead z so the nose pitches up/down along the parabolic arc
    let look-ahead 1.5
    let h-dist distancexy dest-x dest-y
    let next-h-dist max (list 0 (h-dist - look-ahead))
    let next-prog ifelse-value (total-distance > 0) [1 - (next-h-dist / total-distance)] [1]
    set next-prog max (list 0 (min (list 1 next-prog)))
    let look-z -16 + flight-altitude * sin (next-prog * 180)

    ifelse collision-self-detected = true
    [
      ;; heading already adjusted by avoidance turn; apply matching pitch
      set collision-avoidance-ticks collision-avoidance-ticks - 1
      if (collision-avoidance-ticks <= 0) [
        set in-collision-course? false
        set collision-self-detected false
      ]
    ]
    [
      let headingDest towardsxy dest-x dest-y  ;; set horizontal heading toward destination
      let heading-diff (headingDest - heading) mod 360
      if heading-diff > 180 [ set heading-diff heading-diff - 360 ]
      ifelse abs heading-diff > 5 [
        ;; Enable smooth turning
        ifelse heading-diff > 0 [
          right 5
        ] [
          left 5
        ]
      ] 
      [
        ;; Close enough, face exactly
        facexy dest-x dest-y
      ]
      
      facexyz (xcor + look-ahead * sin heading) (ycor + look-ahead * cos heading) look-z  ;; add correct pitch
      set color white
      set roll 0
      
      set collision-avoidance-ticks 5
    ]
    fd 0.1
    
  ]
end

;; Move all planes one tick----------------------

to move-planes
  ask planes with [not crashed?] [
    set flight-progress flight-progress + flight-speed

    ;; If arrived at destination (close enough horizontally), pick a new one and continue flying
    if distancexy dest-x dest-y < 1.0 [
      let new-dest one-of airport-locations
      while [item 0 new-dest = dest-x and item 1 new-dest = dest-y] [
        set new-dest one-of airport-locations
      ]
      set origin-x dest-x
      set origin-y dest-y
      set dest-x item 0 new-dest
      set dest-y item 1 new-dest
      set flight-progress 0
      set arc-factor (random-float 4 - 2)
      
      ;; Assign a fresh random altitude for the new leg
      let alt-range (MaxFlightAltitude - MinFlightAltitude)
      set flight-altitude MinFlightAltitude + random-float (max (list alt-range 0))
      
      ;; Recompute total horizontal distance for the new leg
      let dx2 dest-x - origin-x
      let dy2 dest-y - origin-y
      set total-distance sqrt (dx2 * dx2 + dy2 * dy2)
      
      set dest patch item 0 new-dest item 1 new-dest item 2 new-dest
    ]
    update-position
  ]
end

;; Collision detection ----------------------

to check-collisions
  ;; Any patch with 2+ airplanes = crash
  ask patches with [not is-airport?] [
    let nearby planes-here with [not crashed?]
    if count nearby >= 2 [
      set total-crashes total-crashes + 1
      ask nearby [ set crashed? true ]
      set crash-occured? true
    ]
  ]
  ;; Remove crashed planes
  ask planes with [crashed?] [ die ]
  
end

to explode
  ask patches [ 
    if crash-occured? [
      set pcolor (list 255 0 0 255)
      set crash-occured? false
    ]
  ]
end

to color-correct
  ask patches [ 
    if is-list? pcolor [
      let newRed (item 0 pcolor)
      let newGreen (item 1 pcolor)
      let newBlue (item 2 pcolor)
      let transparency (item 3 pcolor)
      
      if newRed > 0 or newGreen > 0 or newBlue > 0 [
        if newRed > redRgb [
          set newRed newRed - 0.75
          if newRed < 0 [
            set newRed 0
          ]
        ]
        if newRed < redRgb [
          set newRed newRed + 0.75
          if newRed > 255 [
            set newRed 255
          ]
        ]
        
        if newBlue > blueRgb [
          set newBlue newBlue - 0.75
          if newBlue < 0 [
            set newBlue 0
          ]
        ]
        if newBlue < blueRgb [
          set newBlue newBlue + 0.75
          if newBlue > 255 [
            set newBlue 255
          ]
        ]
        
        if newGreen > greenRgb [
          set newGreen newGreen - 0.75
          if newGreen < 0 [
            set newGreen 0
          ]
        ]
        if newGreen < greenRgb [
          set newGreen newGreen + 0.75
          if newGreen > 255 [
            set newGreen 255
          ]
        ]
        
        if not is-land? and pzcor > -16 [
          set transparency transparency - 1
          if transparency < 0 [
            set transparency 0
          ]
        ]
        
        
        set pcolor (list newRed newGreen newBlue transparency)
      ]
    ]
  ]
    
end

to air-traffic-control-operations 
  ask patches [
    ; Check if it is an air traffic controller
    if is-controller? [
      ; Put in planes-nearby the set of agents near each AirTrafficController within the radius AirTrafficControllerRange
      let planes-nearby planes-on (patches in-radius AirTrafficControllerRange with [pzcor < -16 + AirTrafficControllerRange])
      let planeCount count planes-nearby
      if planeCount > 1 [
        let legit-collision false
        ask planes-nearby [
          ; Get each planes' forward trajectory
          set ahead-patches n-values AirTrafficControllerRange [ i ->
            patch-ahead (i + 1)
          ]
          ; compare each other's forward trajactory if they intersect
          ask other planes-nearby [
            set ahead-patches n-values AirTrafficControllerRange [ i ->
              patch-ahead (i + 1)
            ]
            let index 0
            while [index <  length ahead-patches] [
              if item index ahead-patches = item index [ahead-patches] of myself [
                
                
                ask item index ahead-patches [
                  if not is-airport? [
                    set legit-collision true
                    ;Marking the spots where a crash will occur to Orange
                    
                    if pzcor < -16 + AirTrafficControllerRange [
                      set pcolor (list 255 165 0 255)
                    ]
                  ]
                ]
                if legit-collision = true [
                  stop
                ]
              ]
              set index index + 1
            ]
          ]
          
          if legit-collision = true [
            set in-collision-course? true
          ]
          
        ]
      ]
    ]
  ]
end

to takeoff
  ask patches with [is-airport?] [
    let planeSet planes-here
    if count planeSet > 0 [
      ask planeSet [
        set takeoff-allowed? false
      ]
      ask first sort planeSet [
        set takeoff-allowed? true
      ]
    ]
  ]
end

;; GO (main simulation loop)

to go
  spawn-airplanes
  takeoff
  air-traffic-control-operations
  move-planes
  check-collisions
  explode
  color-correct
  tick
end

]]></code>
  <widgets>
    <view3d wrappingAllowedZ="true" x="0" wrappingAllowedX="true" y="0" minPycor="-18" height="216" showTickCounter="true" patchSize="6.0" fontSize="10" wrappingAllowedY="true" width="360" tickCounterLabel="ticks" maxPycor="17" updateMode="0" frameRate="30.0" maxPzcor="16" maxPxcor="30" minPxcor="-29" minPzcor="-16"></view3d>
    <button x="25" y="20" height="50" disableUntilTicks="false" forever="false" kind="Observer" width="100" display="Setup">setup</button>
    <button x="140" y="20" height="50" disableUntilTicks="true" forever="true" kind="Observer" width="100" display="Go">go</button>
    <slider x="30" step="1" y="90" max="100" width="210" display="NumOfAirplanes" height="50" min="0" direction="Horizontal" default="100.0" variable="NumOfAirplanes"></slider>
    <slider x="30" step="1" y="165" max="12" width="210" display="NumOfAirTrafficControllers" height="50" min="0" direction="Horizontal" default="12.0" variable="NumOfAirTrafficControllers"></slider>
    <slider x="30" step="1" y="425" max="10" width="210" display="AircraftPerceptionRange" height="50" min="0" direction="Horizontal" default="4.0" variable="AircraftPerceptionRange"></slider>
    <slider x="30" step="1" y="490" max="16" width="210" display="MinFlightAltitude" height="50" min="0" direction="Horizontal" default="4.0" variable="MinFlightAltitude"></slider>
    <slider x="30" step="1" y="555" max="32" width="210" display="MaxFlightAltitude" height="50" min="1" direction="Horizontal" default="11.0" variable="MaxFlightAltitude"></slider>
    <slider x="30" step="1" y="365" max="16" width="210" display="AirTrafficControllerRange" height="50" min="0" direction="Horizontal" default="16.0" variable="AirTrafficControllerRange"></slider>
    <monitor x="140" precision="0" y="290" height="60" fontSize="11" width="100" display="Total Crashes">total-crashes</monitor>
    <monitor x="30" precision="0" y="290" height="60" fontSize="11" width="100" display="Active Planes">count planes</monitor>
    <monitor x="140" precision="0" y="230" height="60" fontSize="11" width="100" display="Controllers">count patches with [is-controller?]</monitor>
    <monitor x="30" precision="0" y="230" height="60" fontSize="11" width="100" display="Airports">count patches with [is-airport?]</monitor>
  </widgets>
  <info>## WHAT IS IT?

A 3D simulation of global air traffic with realistic curved flight paths and collision detection.
Part of CPSC 565 Emergent Systems - Group 4 (Julian Fan, Elda Britu, Harshini Poluri).

## HOW IT WORKS

- **Green patches** = land (continents)
- **Yellow patches** = airports (labeled with IATA codes)
- **Red patches** = Air Traffic Controller (ATC) stations
- **White airplane turtles** = active flights

Each airplane is assigned a random origin and destination airport. It follows a **curved arc path** (a great-circle approximation) rather than a straight line. The arc direction and curvature vary randomly per flight segment, producing varied, realistic-looking routes.

When a plane arrives at its destination it immediately picks a new destination and continues flying, keeping the skies perpetually busy.

**Collision detection**: at each tick, any patch occupied by two or more airplanes triggers a crash — all involved planes despawn and the crash counter increments.

## HOW TO USE IT

1. Set **NumOfAirplanes** and **NumOfAirTrafficControllers** with the sliders.
2. Click **Setup** to generate the map.
3. Click **Go** to start the simulation.
4. Watch the **Active Planes** and **Total Crashes** monitors.

## THINGS TO NOTICE

- Flight arcs curve naturally due to the perpendicular arc offset (sin-based midpoint bulge).
- Planes face their direction of travel at all times.
- Increasing plane density raises collision frequency.

## THINGS TO TRY

- Crank **NumOfAirplanes** to 80–100 and watch crash rates climb.
- Reduce to 5–10 and observe sparse long-haul routes.

## EXTENDING THE MODEL

- Give ATC stations an influence radius that reroutes nearby planes to avoid collisions.
- Add altitude layers to reduce collision probability.
- Color-code planes by region or airline.
- Log crash locations to a heatmap.

## CREDITS AND REFERENCES

CPSC 565 Emergent Systems - University of Calgary
Group 4: Julian Fan, Elda Britu (30158734), Harshini Poluri (30188914)
</info>
