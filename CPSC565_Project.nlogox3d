<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 3D 7.0.3" snapToGrid="true">
  <code><![CDATA[

breed [planes plane]

globals [
  airport-locations    ;; list of [x y name] for each airport
  controller-locations ;; list of [x y] for each ATC
  total-crashes        ;; total number of crash incidents
  controllerFound      ;; boolean dictating if a controller can be built on a location (to ensure 2 ATCs are not built in the same location)
  placed               ;; Number of ATCs placed so far
]

patches-own [
  is-land?       ;; true if this patch is land
  is-airport?    ;; true if this patch is an airport
  airport-name   ;; name label for airport patches
  crash-occured? ;; true if a crash took place in the patch
  redRgb         ;; red rgb value
  blueRgb        ;; blue rgb value
  greenRgb       ;; green rgb value
  is-controller? ;; true if this patch is an air traffic controller zone
  incoming-plane ;; The plane set for collision course.
]

turtles-own [
  origin-x                   ;; starting airport x
  origin-y                   ;; starting airport y
  origin-z                   ;; starting airport z
  dest-x                     ;; destination airport x
  dest-y                     ;; destination airport y
  dest-z                     ;; destination airport z
  dest                       ;; destination airport patch
  flight-progress            ;; 0.0 = just departed, 1.0 = arrived
  flight-speed               ;; progress per tick (controls plane speed)
  arc-factor                 ;; curvature magnitude and direction of the path
  crashed?                   ;; flagged for removal after collision
  in-collision-course?       ;; tracking if detected that another plane is in front of it (used by Air Traffic Controllers to warn planes)
  collision-self-detected    ;; tracking if plane itself detects a collision ahead
  ahead-patches              ;; their path forward
  takeoff-allowed?           ;; boolean that ensures only 1 aircraft leaves an airport at a time
  flight-altitude            ;; max altitude (above ground) for this plane's parabolic arc
  total-distance             ;; total horizontal distance from origin to destination (used for arc progress)
  collision-avoidance-ticks  ;; Number of ticks spent to avoid a collision
]

;; Setup
to setup
  clear-all
  set total-crashes 0

  ;; Step 1: Paint the ocean (blue background)
  ask patches [
    set is-land? false
    set is-airport? false
    set is-controller? false
    set airport-name ""
    set crash-occured? false
    
    if pzcor = -16 [
      set pcolor 87  ;; blue ocean
      let rgbVer extract-rgb pcolor
      set pcolor (list item 0 rgbVer item 1 rgbVer item 2 rgbVer 255)
    ]
    
    
  ]

  ;; Step 2: Draw continents as green land masses
  draw-continents

  ;; Step 3: Place airports (yellow patches)
  place-airports

  ;; Step 4: Place air traffic controllers (red patches)
  place-controllers

  ;; Setting the redRgb value for all patches (used by color-correct method)
  ask patches [
    let current-rgb ifelse-value (is-list? pcolor) 
                     [ pcolor ] 
                     [ extract-rgb pcolor ]
    set redRgb (item 0 current-rgb)
    set greenRgb (item 1 current-rgb)
    set blueRgb (item 2 current-rgb)
  ]
  reset-ticks
end

