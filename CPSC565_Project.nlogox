<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.3" snapToGrid="true">
  <code><![CDATA[

breed [planes plane]

globals [
  airport-locations    ;; list of [x y name] for each airport
  controller-locations ;; list of [x y] for each ATC
  total-crashes        ;; total number of crash incidents
  safelandings         ;; number of planes that made a safe journey from origin to destination
  closecalls           ;; number of planes that nearly crashed
]

patches-own [
  is-land?       ;; true if this patch is land
  is-airport?    ;; true if this patch is an airport
  airport-name   ;; name label for airport patches
  crash-occured? ;; true if a crash took place in the patch
  redRgb         ;; red rgb value
  blueRgb        ;; blue rgb value
  greenRgb       ;; green rgb value
  is-controller? ;; true if this patch is an air traffic controller zone
  incoming-plane ;; The plane set for collision course.
]

turtles-own [
  origin-x            ;; starting airport x
  origin-y            ;; starting airport y
  dest-x              ;; destination airport x
  dest-y              ;; destination airport y
  dest                ;; destination airport patch
  flight-progress     ;; 0.0 = just departed, 1.0 = arrived
  flight-speed        ;; progress per tick (controls plane speed)
  arc-factor          ;; curvature magnitude and direction of the path
  crashed?            ;; flagged for removal after collision
  in-collision-course?;; tracking if detected that another plane is in front of it (used by Air Traffic Controllers to warn planes)
  ahead-patches       ;; their path forward
  takeoff-allowed?    ;; boolean that ensures only 1 aircraft leaves an airport at a time
  danger?             ;; boolean determining if the plane is too close to another plane
]

;; Setup
to setup
  clear-all
  set total-crashes 0
  set safelandings 0
  set closecalls 0

  ;; Step 1: Paint the ocean (blue background)
  ask patches [
    set pcolor 87  ;; blue ocean
    set is-land? false
    set is-airport? false
    set is-controller? false
    set airport-name ""
    set crash-occured? false
    
    

  ]

  ;; Step 2: Draw continents as green land masses
  draw-continents

  ;; Step 3: Place airports (yellow patches)
  place-airports

  ;; Step 4: Place air traffic controllers (red patches)
  place-controllers

  ;; Setting the redRgb value for all patches (used by color-correct method)
  ask patches [
    let current-rgb ifelse-value (is-list? pcolor) 
                     [ pcolor ] 
                     [ extract-rgb pcolor ]
    set redRgb (item 0 current-rgb)
    set greenRgb (item 1 current-rgb)
    set blueRgb (item 2 current-rgb)
  ]
  
  reset-ticks
end

;; Drawing continents
;; Simplified world map on a 33x33 grid (-16 to 16)

to draw-continents

  ;; --- North America ---
  draw-landmass -14 6 -6 14    ;; main body (Canada/US)
  draw-landmass -12 3 -7 6     ;; southern US
  draw-landmass -10 1 -8 3     ;; Mexico
  draw-landmass -9 -1 -8 1     ;; Central America

  ;; --- South America ---
  draw-landmass -8 -12 -4 -2   ;; main body
  draw-landmass -7 -14 -5 -12  ;; southern tip
  draw-landmass -7 -2 -4 0     ;; northern part (Colombia/Venezuela)

  ;; --- Europe ---
  draw-landmass -1 8 6 14      ;; main body
  draw-landmass -2 6 3 8       ;; southern Europe
  draw-landmass 6 8 8 12       ;; Scandinavia-ish
  draw-landmass 0 5 4 7        ;; Iberian/Italy area

  ;; --- Africa ---
  draw-landmass 0 -10 5 4      ;; main body
  draw-landmass 1 -12 4 -10    ;; southern tip
  draw-landmass 5 0 7 3        ;; Horn of Africa

  ;; --- Asia ---
  draw-landmass 6 4 16 14      ;; Russia / Northern Asia
  draw-landmass 5 0 12 5       ;; Middle East / Central Asia
  draw-landmass 10 -2 14 4     ;; India / Southeast Asia
  draw-landmass 13 2 16 8      ;; China / East Asia
  draw-landmass 14 -1 16 2     ;; Southeast Asia extension

  ;; --- Australia ---
  draw-landmass 10 -12 15 -7   ;; main body
  draw-landmass 13 -7 15 -6    ;; northern bit

end

;; green (land)
to draw-landmass [x1 y1 x2 y2]
  ask patches [
    if pxcor >= x1 and pxcor <= x2 and pycor >= y1 and pycor <= y2 [
      set pcolor 55     ;; green land
      set is-land? true
    ]
  ]
end

;; airports: (Yellow patches with labels)

to place-airports
  ;; Define airport locations: [x y "name"]
  set airport-locations (list
    (list -12 10 "YYC")     ;; Calgary, Canada
    (list -10 8  "JFK")     ;; New York, USA
    (list -9  4  "LAX")     ;; Los Angeles, USA
    (list -8  1  "MEX")     ;; Mexico City
    (list -6 -5  "GRU")     ;; São Paulo, Brazil
    (list -5 -11 "EZE")     ;; Buenos Aires, Argentina
    (list  2  10 "LHR")     ;; London, UK
    (list  4  8  "CDG")     ;; Paris, France
    (list  2  2  "CAI")     ;; Cairo, Egypt
    (list  3 -7  "JNB")     ;; Johannesburg, South Africa
    (list  7  5  "DXB")     ;; Dubai, UAE
    (list  9  10 "SVO")     ;; Moscow, Russia
    (list 11  1  "BOM")     ;; Mumbai, India
    (list 14  6  "PEK")     ;; Beijing, China
    (list 15  3  "HKG")     ;; Hong Kong
    (list 13 -10 "SYD")     ;; Sydney, Australia
  )

  ;; Paint each airport location yellow and label it
  foreach airport-locations [ loc ->
    let ax item 0 loc
    let ay item 1 loc
    let aname item 2 loc
    
    ;; Make a 1-patch airport marker (yellow)
    ask patch ax ay [
      set pcolor 45          ;; yellow
      set is-airport? true
      set is-land? true
      set airport-name aname
    ]
    
    ;; Create a label turtle at the airport
    ask patch ax ay [
      sprout 1 [
        set shape "circle"
        set size 0.01
        set pcolor yellow
        set label aname
        set label-color white
      ]
    ]
  ]
end
  
;; air traffic controllers (Red patches)
;; Controllers are placed on land between airports

to place-controllers
  ;; Define ATC positions on land, spread around the map
  set controller-locations (list
    (list -11 12)    ;; Northern Canada ATC
    (list -10 6)     ;; US East Coast ATC
    (list -7  3)     ;; Central America ATC
    (list -7 -8)     ;; South America ATC
    (list  0  12)    ;; North Atlantic ATC
    (list  3  6)     ;; European ATC
    (list  2 -3)     ;; Central Africa ATC
    (list  6  3)     ;; Middle East ATC
    (list  8  12)    ;; Russia West ATC
    (list 12  8)     ;; East Asia ATC
    (list 12 -1)     ;; South Asia ATC
    (list 12 -9)     ;; Australia ATC
  )

  ;; Only place up to NumOfAirTrafficControllers controllers
  let num-to-place min (list NumOfAirTrafficControllers length controller-locations)
  let placed 0

  
  while [placed < num-to-place] [
    let contr_location_length (length controller-locations)
    let randomIndex (random contr_location_length)
    let cx item 0 item randomIndex controller-locations
    let cy item 1 item randomIndex controller-locations
    ask patch cx cy [
      if is-land? and not is-airport? and not is-controller? [
        set pcolor 15
        set is-controller? true
        sprout 1 [
          set shape "circle"
          set size 0.01
          set pcolor blue
          set label "ATC"
          set label-color white
        ]
        set placed placed + 1
        
      ]
      
      set controller-locations remove-item randomIndex controller-locations
    ]
  ]
end

;; Airplane spawning ----------------------

to spawn-airplanes
  ;; Maintain the target count of active airplanes
  let current-count count planes
  let needed max (list 0 (NumOfAirplanes - current-count))

  repeat needed [
    ;; Pick random distinct origin and destination airports
    let src one-of airport-locations
    let dst one-of airport-locations
    while [item 0 dst = item 0 src and item 1 dst = item 1 src] [
      set dst one-of airport-locations
    ]

    create-planes 1 [
      set shape "airplane"
      set color white
      set size 1.2
      set label ""

      set origin-x item 0 src
      set origin-y item 1 src
      set dest-x   item 0 dst
      set dest-y   item 1 dst
      
      set dest patch item 0 dst item 1 dst

      ;; Stagger departure progress so planes don't all start at origin
      set flight-progress random-float 1.0
      ;; Speed variation: slower planes = 0.003, faster = 0.008
      set flight-speed    0.003 + random-float 0.005
      ;; Arc curvature: positive = curves one way, negative = other way
      set arc-factor (random-float 4 - 2)
      set crashed? false
      set in-collision-course? false
      set takeoff-allowed? false
      set danger? false
      
      ;; Set location at the airport
      setxy origin-x origin-y

      ;; Place at correct position along arc immediately
      update-position
    ]
  ]
end

;; Position update along arc----------------------

;; Is there any way to have the planes wrap around to get to the airports by shortest means? Eg: use the face method
; face method works as such: If wrapping is allowed by the topology and the wrapped distance (around the edges of the world) is shorter, face will use the wrapped path.
; If the caller and the agent are at the exact same position, the caller’s heading won’t change.

;; Called on the airplane turtle; sets its xcor/ycor along a curved arc.
to update-position
  let t flight-progress
  let delta-x dest-x - origin-x
  let delta-y dest-y - origin-y
  let d sqrt (delta-x * delta-x + delta-y * delta-y)

  ;; Linear interpolation
  ;let lx origin-x + t * delta-x
  ;let ly origin-y + t * delta-y

  ;; Add perpendicular arc offset: sin(t*π) peaks at midpoint → 0 at both ends
  ;if d > 0 [
    ;let perp-x (- delta-y / d)
    ;let perp-y (  delta-x / d)
    ;let offset sin (t * 180) * arc-factor
    ;set lx lx + perp-x * offset
    ;set ly ly + perp-y * offset
  ;]

  ;; Clamp to world bounds
  ;set lx max (list (min-pxcor) (min (list max-pxcor lx)))
  ;set ly max (list (min-pycor) (min (list max-pycor ly)))

  ;setxy lx ly

  ;; Face the direction of travel (look slightly ahead on the arc)
  ;let t2 min (list 1.0 (t + 0.02))
  ;let lx2 origin-x + t2 * delta-x
  ;let ly2 origin-y + t2 * delta-y
  ;if d > 0 [
  ;  let perp-x2 (- delta-y / d)
  ;  let perp-y2 (  delta-x / d)
  ;  let offset2 sin (t2 * 180) * arc-factor
  ;  set lx2 lx2 + perp-x2 * offset2
  ;  set ly2 ly2 + perp-y2 * offset2
  ;]
  ;if (lx2 - xcor) != 0 or (ly2 - ycor) != 0 [
  ;  facexy lx2 ly2
  ;]
  
  if takeoff-allowed? [
    ;; Collision detection code: The planes have a limited sight ahead of them.
    let numOfTurtles 0
    set ahead-patches n-values AircraftPerceptionRange [ i ->
      patch-ahead (i + 1)
    ]
    let index 0
    let collision-detected false
    
    while [index <  length ahead-patches] [
      if count other planes-on item index ahead-patches > 0 [
        set collision-detected true
        set incoming-plane one-of other planes-on item index ahead-patches
        set index length ahead-patches
      ]
      
      set index index + 1
    ]
    
    if collision-detected = true [
      set color orange
      let incoming-heading 0
      ask incoming-plane [
        set incoming-heading heading
      ]
      let incoming-heading-normalised incoming-heading - heading
      if incoming-heading-normalised > 180 [ 
        set incoming-heading-normalised incoming-heading-normalised - 360 
      ]  ;; now -180 to 180
      ifelse incoming-heading-normalised > 0 [ 
        left 15
      ] 
      [ 
        right 15
      ]
    ]
    
    ;; Collision detection based on what the air traffic controller tells them
    if in-collision-course? [
      set ahead-patches n-values AirTrafficControllerRange [ i ->
        patch-ahead (i + 1)
      ]
      set index 0
      set collision-detected false
      while [index <  length ahead-patches] [
        ask item index ahead-patches [
          let current-rgb ifelse-value (is-list? pcolor) 
                        [ pcolor ] 
          [ extract-rgb pcolor ]
          if item 0 current-rgb > 200 [
            set collision-detected true
          ]
        ]
        set index index + 1
      ]
      if collision-detected = true [
        set color orange
        let rand random 1
        ifelse rand = 0 [ 
          right 30
        ] 
        [ 
          left 30
        ]
      ]
      set in-collision-course? false
    ]
    
    ifelse collision-detected = false [
      facexy dest-x dest-y
      set color white
      fd 0.1
    ]
    [
      fd 0.05
    ]
    
  ]
end

;; Move all planes one tick----------------------

to move-planes
  ask planes with [not crashed?] [
    set flight-progress flight-progress + flight-speed

    ;; If arrived at destination, pick a new one and continue flying
    ;if flight-progress >= 1 [
    if patch-here = dest [
      set safelandings safelandings + 1
      let new-dest one-of airport-locations
      while [item 0 new-dest = dest-x and item 1 new-dest = dest-y] [
        set new-dest one-of airport-locations
      ]
      set origin-x dest-x
      set origin-y dest-y
      set dest-x item 0 new-dest
      set dest-y item 1 new-dest
      set flight-progress 0
      set arc-factor (random-float 4 - 2)
      
      set dest patch item 0 new-dest item 1 new-dest
    ]

    update-position
  ]
end

;; Collision detection ----------------------

to check-collisions
  ;; Any patch with 2+ airplanes = crash
  ask patches with [not is-airport?] [
    let nearby planes-here with [not crashed?]
    if count nearby >= 2 [
      set total-crashes total-crashes + 1
      ask nearby [ set crashed? true ]
      set crash-occured? true
    ]
  ]
  
  ;; Check if planes are closer to each other by distance 1, classify as close call
  ask planes [
    let closest-one min-one-of other planes [distance myself]
    if closest-one != nobody [
      let dist distance closest-one
      ifelse dist < 1 and not crashed? and not danger? [
        set closecalls closecalls + 1
        set danger? true
      ]
      [
       if dist >= 1 [
          set danger? false
       ]
      ]
    ]
  ]
  ;; Remove crashed planes
  ask planes with [crashed?] [ die ]
  
end

to explode
  ask patches [ 
    let current-rgb ifelse-value (is-list? pcolor) 
                     [ pcolor ] 
                     [ extract-rgb pcolor ]
    let newRed (item 0 current-rgb)
    
    if crash-occured? [
      set pcolor black
      set crash-occured? false
    ]
  ]
end

to color-correct
  ask patches [ 
    let current-rgb ifelse-value (is-list? pcolor) 
                     [ pcolor ] 
                     [ extract-rgb pcolor ]
    let newRed (item 0 current-rgb)
    let newGreen (item 1 current-rgb)
    let newBlue (item 2 current-rgb)
    
    
    if newRed > redRgb [
      set newRed newRed - 0.75
    ]
    if newRed < redRgb [
      set newRed newRed + 0.75
    ]
    
    if newBlue > blueRgb [
      set newBlue newBlue - 0.75
    ]
    if newBlue < blueRgb [
      set newBlue newBlue + 0.75
    ]
    
    if newGreen > greenRgb [
      set newGreen newGreen - 0.75
    ]
    if newGreen < greenRgb [
      set newGreen newGreen + 0.75
    ]
    
    
    set pcolor (rgb newRed newGreen newBlue)
  ]
    
end

to air-traffic-control-operations 
  ask patches [
    ; Check if it is an air traffic controller
    if is-controller? [
      ; Put in planes-nearby the set of agents near each AirTrafficController within the radius AirTrafficControllerRange
      let planes-nearby planes-on (patches in-radius AirTrafficControllerRange)
      let planeCount count planes-nearby
      if planeCount > 1 [
        let legit-collision false
        ask planes-nearby [
          ; Get each planes' forward trajectory
          set ahead-patches n-values AirTrafficControllerRange [ i ->
            patch-ahead (i + 1)
          ]
          ; compare each other's forward trajactory if they intersect
          ask other planes-nearby [
            set ahead-patches n-values AirTrafficControllerRange [ i ->
              patch-ahead (i + 1)
            ]
            let index 0
            while [index <  length ahead-patches] [
              if item index ahead-patches = item index [ahead-patches] of myself [
                
                
                ask item index ahead-patches [
                  if not is-airport? [
                    set legit-collision true
                    ;Marking the spots where a crash will occur to red
                    set pcolor red
                  ]
                ]
                if legit-collision = true [
                  stop
                ]
              ]
              set index index + 1
            ]
          ]
          
          if legit-collision = true [
            set in-collision-course? true
          ]
          
        ]
      ]
    ]
  ]
end

to takeoff
  ask patches with [is-airport?] [
    let planeSet planes-here
    if count planeSet > 0 [
      ask planeSet [
        set takeoff-allowed? false
      ]
      ask first sort planeSet [
        set takeoff-allowed? true
      ]
    ]
  ]
end

;; GO (main simulation loop)

to go
  spawn-airplanes
  takeoff
  air-traffic-control-operations
  move-planes
  check-collisions
  explode
  color-correct
  tick
end

]]></code>
  <widgets>
    <view x="260" wrappingAllowedX="true" y="10" frameRate="30.0" minPycor="-16" height="530" showTickCounter="true" patchSize="16.0" fontSize="10" wrappingAllowedY="true" width="530" tickCounterLabel="ticks" maxPycor="16" updateMode="1" maxPxcor="16" minPxcor="-16"></view>
    <button x="10" y="10" height="50" disableUntilTicks="false" forever="false" kind="Observer" width="100" display="Setup">setup</button>
    <monitor x="10" precision="0" y="220" height="60" fontSize="11" width="110" display="Airports">count patches with [is-airport?]</monitor>
    <monitor x="10" precision="0" y="280" height="60" fontSize="11" width="110" display="Active Planes">count planes</monitor>
    <monitor x="10" precision="17" y="345" height="60" fontSize="11" width="110" display="Safe Landings">safelandings</monitor>
    <monitor x="120" precision="17" y="345" height="60" fontSize="11" width="110" display="Close Encounters">closecalls</monitor>
    <monitor x="120" precision="0" y="280" height="60" fontSize="11" width="110" display="Total Crashes">total-crashes</monitor>
    <monitor x="120" precision="0" y="220" height="60" fontSize="11" width="110" display="Controllers">count patches with [is-controller?]</monitor>
    <slider x="10" step="1" y="80" max="100" width="220" display="NumOfAirplanes" height="50" min="0" direction="Horizontal" default="100.0" variable="NumOfAirplanes"></slider>
    <slider x="10" step="1" y="150" max="12" width="220" display="NumOfAirTrafficControllers" height="50" min="0" direction="Horizontal" default="0.0" variable="NumOfAirTrafficControllers"></slider>
    <button x="130" y="10" height="50" disableUntilTicks="true" forever="true" kind="Observer" width="100" display="Go">go</button>
    <plot x="800" autoPlotX="true" yMax="50.0" autoPlotY="true" yAxis="Safe landings" y="10" xMin="0.0" height="250" legend="false" xMax="50.0" yMin="0.0" width="365" xAxis="Time (ticks)" display="Safe Landings vs Time">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="0" display="default" color="-13840069" legend="true">
        <setup></setup>
        <update>plot safelandings</update>
      </pen>
    </plot>
    <plot x="1170" autoPlotX="true" yMax="100.0" autoPlotY="true" yAxis="Close Encounters" y="10" xMin="0.0" height="250" legend="false" xMax="50.0" yMin="0.0" width="355" xAxis="Time (ticks)" display="Close Encounters vs Time">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="0" display="default" color="-4079321" legend="true">
        <setup></setup>
        <update>plot closecalls</update>
      </pen>
    </plot>
    <plot x="800" autoPlotX="true" yMax="100.0" autoPlotY="true" yAxis="Total Crashes" y="265" xMin="0.0" height="270" legend="false" xMax="50.0" yMin="0.0" width="725" xAxis="Time (ticks)" display="Total Crashes vs Time">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="0" display="default" color="-2674135" legend="true">
        <setup></setup>
        <update>plot total-crashes</update>
      </pen>
    </plot>
    <slider x="10" step="1" y="410" max="100" width="220" display="AirTrafficControllerRange" height="50" min="0" direction="Horizontal" default="5.0" variable="AirTrafficControllerRange"></slider>
    <slider x="10" step="1" y="465" max="10" width="220" display="AircraftPerceptionRange" height="50" min="0" direction="Horizontal" default="1.0" variable="AircraftPerceptionRange"></slider>
  </widgets>
  <info><![CDATA[# Modeling Air Traffic: 2D Simulation
## Julian Fan - Elda Britu - Harshini Poluri

This model simulates global air traffic on a simplified 2D world map. Airplanes continuously fly between 16 real-world airports, following direct heading-based paths. The simulation models two layers of collision avoidance: **onboard aircraft perception**, where each plane scans the patches directly ahead of it and steers away from any plane it detects; and **Air Traffic Controller (ATC) stations**, which monitor a wider radius around them, predict flight path intersections, mark danger zones red, and alert planes to adjust heading. The goal is to explore how these two emergent safety mechanisms, local and global, affect crash rates, close calls, and safe landing counts at varying traffic densities.


## HOW IT WORKS

### The World

The 33×33 patch grid is painted to represent a simplified world map:

- **Blue patches** - ocean
- **Green patches** - land (continents: North America, South America, Europe, Africa, Asia, Australia)
- **Yellow patches** - airports, labeled with their IATA codes (e.g., YYC, JFK, LHR, SYD). There are 16 airports total.
- **Red patches** - Air Traffic Controller (ATC) stations, placed on land between airports. Up to 12 ATC stations can be placed, controlled by the **NumOfAirTrafficControllers** slider.

### Airplanes

Each airplane turtle is assigned a random origin and destination airport at spawn. Planes fly by facing their destination patch each tick (`facexy`) and moving forward by 0.1 patches. Speed varies slightly between planes (0.003–0.008 progress units per tick). When a plane reaches its destination, it immediately picks a new random destination and continues flying and keeping the skies perpetually busy.

**Takeoff queuing**: Only one plane per airport is permitted to take off at a time. Planes queue at their origin airport and the first in line is granted `takeoff-allowed? true` each tick.

### Aircraft Self-Avoidance (Local Perception)

Each tick, an active plane scans the `AircraftPerceptionRange` patches directly ahead of it. If another plane is detected in those patches:

- The plane turns orange to signal a near-miss.
- It compares headings with the incoming plane and turns 15° left or right to avoid a head-on path.
- It advances at half speed (0.05 instead of 0.1) while evading.

### Air Traffic Control (ATC)

Each ATC station (red patch) scans all planes within its `AirTrafficControllerRange` radius. When two or more planes are detected nearby, the ATC compares the forward trajectories of every pair. If any pair shares a patch in their projected paths:

- That patch is painted **red** as a visual danger marker.
- Both planes have their `in-collision-course?` flag set to `true`.

On the next tick, flagged planes re-scan their ahead-patches looking for red patches. If a red patch is found, the plane turns 30° (randomly left or right) to reroute. Patches gradually fade back to their original color via the `color-correct` procedure, which incrementally shifts each patch's RGB values toward their original recorded values.

### Collision Detection and Crashes

At each tick, every non-airport patch is checked for two or more planes occupying the same location. If found:

- All involved planes are marked `crashed?` and immediately removed.
- The crash counter increments by 1.
- The patch flashes **black** briefly before color-correcting back.

**Close calls** are tracked separately: any two planes that come within distance 1 of each other (without actually crashing) increment the close encounters counter. A plane can only trigger one close-call event per near-miss encounter.


### Sliders

<table border="1" cellspacing="0" cellpadding="6" style="color: white; background-color: black;">
  <thead>
    <tr>
      <th>Slider</th>
      <th>Range</th>
      <th>Description</th>
    </tr>
  </thead>
  <tbody>
    <tr>
      <td><strong>NumOfAirplanes</strong></td>
      <td>0–100</td>
      <td>Target number of active planes in the simulation</td>
    </tr>
    <tr>
      <td><strong>NumOfAirTrafficControllers</strong></td>
      <td>0–12</td>
      <td>Number of ATC stations placed on the map at setup</td>
    </tr>
    <tr>
      <td><strong>AirTrafficControllerRange</strong></td>
      <td>0–100</td>
      <td>Radius (in patches) that each ATC station monitors for planes and projects flight paths</td>
    </tr>
    <tr>
      <td><strong>AircraftPerceptionRange</strong></td>
      <td>0–10</td>
      <td>Number of patches ahead each plane scans for other planes each tick</td>
    </tr>
  </tbody>
</table>

### Buttons

- **Setup** — Clears the world, draws the map, places airports and ATC stations, and resets all counters. Must be run before Go.
- **Go** *(forever)* — Starts the simulation loop: spawns planes, runs takeoff logic, runs ATC operations, moves planes, checks collisions, and updates colors each tick.

### Monitors

<table border="1" cellspacing="0" cellpadding="6" style="color: white; background-color: black;">
  <thead>
    <tr>
      <th>Monitor</th>
      <th>Description</th>
    </tr>
  </thead>
  <tbody>
    <tr>
      <td><strong>Airports</strong></td>
      <td>Number of airport patches on the map (always 16)</td>
    </tr>
    <tr>
      <td><strong>Controllers</strong></td>
      <td>Number of active ATC station patches</td>
    </tr>
    <tr>
      <td><strong>Active Planes</strong></td>
      <td>Current number of live planes in the simulation</td>
    </tr>
    <tr>
      <td><strong>Total Crashes</strong></td>
      <td>Cumulative number of crash events since Setup</td>
    </tr>
    <tr>
      <td><strong>Safe Landings</strong></td>
      <td>Cumulative number of planes that successfully reached a destination</td>
    </tr>
    <tr>
      <td><strong>Close Encounters</strong></td>
      <td>Cumulative number of near-miss events (distance &lt; 1 between planes)</td>
    </tr>
  </tbody>
</table>

### Plots

- **Safe Landings vs Time** — Tracks cumulative safe landings over ticks (green line).
- **Close Encounters vs Time** — Tracks cumulative close encounters over ticks (teal line).
- **Total Crashes vs Time** — Tracks cumulative crashes over ticks (red line).

## THINGS TO NOTICE

- With **no ATC** and **no aircraft perception** (both ranges at 0), crashes increase linearly with plane density.
- When **AircraftPerceptionRange** is increased, planes self-correct at close range but may cluster in avoidance spirals at very high densities.
- ATC stations mark predicted collision paths red — watch these red flashes appear and fade as planes reroute.
- The **close encounters counter** often rises faster than crashes, revealing near-misses the avoidance system *almost* prevented.
- Airports act as safe zones — crashes cannot be triggered on airport patches, so busy airports briefly protect planes while queuing.
- The **color-correct** procedure causes crash sites (temporarily black) to gradually fade back to their original ocean or land color over several ticks.


## THINGS TO TRY

- Set **NumOfAirplanes** to 100 and all avoidance settings to 0 — observe a crash-heavy baseline.
- Incrementally increase **AircraftPerceptionRange** from 1 to 10 and compare crash rates at the same plane density.
- Add ATC stations one at a time and watch crash and close-call trends change relative to safe landings.
- Try a high **AirTrafficControllerRange** (50+) with only 2–3 ATC stations and compare to many stations with a small range.
- Compare the three plots simultaneously to see how interventions shift the crash-to-landing ratio.]]></info>
